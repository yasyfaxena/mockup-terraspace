    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tanstack/router-plugin": "1.168.23",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
