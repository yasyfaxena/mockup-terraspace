{
  "name": "terraspace-backend",
  "version": "2.0.0",
  "description": "TerraSpace V2 Backend API",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc --noEmit -p jsconfig.json",
    "check": "npm run format:check && npm run lint && npm run types && npm run knip",
    "knip": "knip"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "events": "file:./vendor/events-shim"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@scalar/express-api-reference": "^0.10.18",
    "@sentry/node": "^10.73.0",
    "awilix": "^13.0.5",
    "better-auth": "^1.7.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nanoid": "^6.0.1",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.26.0",
    "zod": "^4.5.4",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@eslint/js": "^9.15.0",
    "@faker-js/faker": "^10.6.0",
    "@react-email/components": "^1.0.12",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "nock": "^14.0.17",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^6.0.0",
    "react-email": "^6.9.3",
    "supertest": "^7.2.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.0"
  }
}
