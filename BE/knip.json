{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/server.js"],
  "project": ["src/**/*.js"],
  "ignore": [
    "src/shared/container.js",
    "src/shared/middleware/validate.js",
    "src/shared/errors/**",
    "src/features/auth/auth.config.js"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "pino-pretty",
    "@react-email/components",
    "react-email",
    "@better-auth/cli",
    "lint-staged",
    "husky",
    "@scalar/express-api-reference",
    "@sentry/node",
    "awilix",
    "date-fns",
    "date-fns-tz",
    "express-rate-limit",
    "node-cron",
    "resend",
    "zod-openapi",
    "eslint-plugin-boundaries",
    "eslint-plugin-import",
    "nock"
  ]
}
