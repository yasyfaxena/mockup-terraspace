{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/server.js"],
  "project": ["src/**/*.js"],
  "ignore": ["src/shared/container.js", "src/shared/errors/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "pino-pretty",
    "react-email",
    "@better-auth/cli",
    "lint-staged",
    "husky",
    "@scalar/express-api-reference",
    "@sentry/node",
    "awilix",
    "express-rate-limit",
    "zod-openapi",
    "nock",
    "@types/html-to-text"
  ],
  "rules": {
    "exports": "warn"
  }
}
