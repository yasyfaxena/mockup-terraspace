DATABASE_URL=postgresql://terraspace:terraspace@localhost:5433/terraspace
NODE_ENV=development
PORT=3000

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Trusted Origins (Comma-separated)
TRUSTED_ORIGINS=http://localhost:5173

# PayBridge
PAYBRIDGE_BASE_URL=https://pt-api.ardial.my.id:55000
PAYBRIDGE_KEY_ID=your-key-id
# Ed25519 private key, PEM format, base64-encoded to survive env newlines.
PAYBRIDGE_PRIVATE_KEY=your-base64-encoded-ed25519-private-key-pem
PAYBRIDGE_APP_CODE=your-4-char-app-code
PAYBRIDGE_CALLBACK_URL=http://localhost:3000/webhooks/paybridge
PAYBRIDGE_PROVIDER=xendit

# Resend
RESEND_API_KEY=your-resend-api-key
