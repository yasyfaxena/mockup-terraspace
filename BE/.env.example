DATABASE_URL=postgresql://terraspace:terraspace@localhost:5433/terraspace
NODE_ENV=development
PORT=3000

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Trusted Origins (Comma-separated)
TRUSTED_ORIGINS=http://localhost:5173

# PayBridge
PAYBRIDGE_KEY_ID=your-key-id
PAYBRIDGE_PRIVATE_KEY=your-private-key

# Resend
RESEND_API_KEY=your-resend-api-key
