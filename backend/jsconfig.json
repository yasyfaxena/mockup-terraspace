{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "#shared/*": ["src/shared/*"],
      "#features/*": ["src/features/*"]
    }
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules"]
}
